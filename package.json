{
  "name": "know-know",
  "version": "0.1.0",
  "private": true,
  "description": "KNOW-KNOW: troca de conhecimento que transforma.",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @know-know/shared build",
    "build": "pnpm build:shared && pnpm --filter @know-know/api build && pnpm --filter @know-know/web build",
    "dev:api": "pnpm build:shared && pnpm --filter @know-know/api dev",
    "dev:web": "pnpm build:shared && pnpm --filter @know-know/web dev",
    "dev:auth": "node scripts/dev-auth-server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "typecheck": "pnpm build:shared && pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm build:shared && pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm build && pnpm --filter @know-know/web e2e",
    "db:generate": "pnpm --filter @know-know/api prisma:generate",
    "db:migrate": "pnpm --filter @know-know/api prisma:migrate",
    "db:seed": "pnpm --filter @know-know/api seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
