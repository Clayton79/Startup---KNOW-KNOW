# Copie para apps/api/.env e preencha. NUNCA versione o .env real.
NODE_ENV=development
# Render injeta PORT automaticamente em produção.
PORT=3000

# Frontend (usado em links e como origem padrão do CORS)
FRONTEND_URL=
# Origens permitidas pelo CORS, separadas por vírgula (sem "*" em produção)
CORS_ALLOWED_ORIGINS=

# Supabase Postgres. DATABASE_URL = pooler (runtime). DIRECT_URL = conexão direta (migrations).
DATABASE_URL=
DIRECT_URL=

# Supabase (Settings > API). A service role key é SEGREDO: só existe no backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Somente se o projeto usar chave simétrica (HS256). Com chaves assimétricas, deixe vazio.
SUPABASE_JWT_SECRET=
SUPABASE_AVATAR_BUCKET=avatars

# Regras de negócio configuráveis
CREDITS_PER_HOUR=10
WELCOME_BONUS_CREDITS=20

# Rate limit global (por IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
